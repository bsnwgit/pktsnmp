[Unit]
Description=pktSNMP SNMP Ingest Management & Visualization Platform
Documentation=https://github.com/vynedental/pktsnmp
After=network.target clickhouse-server.service

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/mnt/software/pktsnmp

Environment=PKTSNMP_CONFIG=/mnt/software/pktsnmp/config.yaml

ExecStart=/mnt/software/pktsnmp/venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8767 \
    --workers 1 \
    --log-level info \
    --no-access-log

Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

StandardOutput=append:/mnt/software/logs/pktsnmp.log
StandardError=append:/mnt/software/logs/pktsnmp.log

NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
