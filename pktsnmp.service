[Unit]
Description=pktSNMP SNMP Ingest Management & Visualization Platform
After=network.target clickhouse-server.service

[Service]
Type=simple
User=pktsnmp
Group=pktsnmp
WorkingDirectory=/opt/pktsnmp

Environment=PKTSNMP_CONFIG=/opt/pktsnmp/config.yaml

ExecStart=/opt/pktsnmp/venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8767 \
    --workers 1 \
    --log-level info \
    --no-access-log

Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

StandardOutput=append:/var/log/pktsnmp.log
StandardError=append:/var/log/pktsnmp.log

NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
